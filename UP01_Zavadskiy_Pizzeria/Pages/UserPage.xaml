<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">
    <Grid Background="#F3F3F3" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="Поиск по ФИО:" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="fioFilterTextBox" MinWidth="150" Margin="7,0,0,0"
                     TextChanged="fioFilterTextBox_TextChanged" ToolTip="Введите ФИО"/>
            <TextBlock Text="Сортировка:" Margin="15,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="sortComboBox" SelectedIndex="0" Width="150" Margin="7,0,0,0"
                      SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы"
                      Margin="15,0,0,0" VerticalAlignment="Center"
                      Checked="onlyAdminCheckBox_Checked" Unchecked="onlyAdminCheckBox_Unchecked"/>
            <Button Content="Очистить" Click="clearFiltersButton_Click" Margin="15,0,0,0"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1" HorizontalContentAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#233E76" BorderThickness="1" CornerRadius="8"
                            Margin="8" Padding="10" Background="White" Width="220">
                        <StackPanel>
                            <Image Width="200" Height="200" Stretch="UniformToFill"
                                   HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/images/default.png</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="{Binding fio}" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding role}" FontSize="12" Foreground="#0198AF"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>