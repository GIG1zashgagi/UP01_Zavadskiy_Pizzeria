<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <Grid Background="#F3F3F3">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Height="420">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Смена пароля" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <StackPanel Grid.Row="1" Margin="0,5">
                <Label Content="Логин"/>
                <TextBox x:Name="TbLogin" ToolTip="Введите логин"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,5">
                <Label Content="Текущий пароль"/>
                <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,5">
                <Label Content="Новый пароль"/>
                <PasswordBox x:Name="NewPasswordBox" ToolTip="Введите новый пароль"/>
                <Label Content="Подтвердите новый пароль"/>
                <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль"/>
            </StackPanel>

            <Button Grid.Row="4" Content="Сохранить" Click="ButtonSave_Click"
                    HorizontalAlignment="Center" Margin="0,20,0,0" ToolTip="Изменить пароль"/>
        </Grid>
    </Grid>
</Page>