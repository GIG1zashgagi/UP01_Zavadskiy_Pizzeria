<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.OrdersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы">
    <Grid Background="#F3F3F3" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridPayment" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding order_date, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding customers.first_name}" Width="120"/>
                <DataGridTextColumn Header="Пиццерия" Binding="{Binding pizzerias.name}" Width="150"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding order_types.name}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding order_statuses.name}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding final_amount, StringFormat=N2}" Width="100"/>
                <DataGridTemplateColumn Header="Действие" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="ButtonEdit_Click"
                                    Height="26" MinWidth="110" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Добавить" Click="ButtonAdd_Click"/>
            <Button Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>