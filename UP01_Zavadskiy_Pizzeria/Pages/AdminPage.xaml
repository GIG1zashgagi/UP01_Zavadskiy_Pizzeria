<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">
    <Grid Background="#F3F3F3">
        <UniformGrid Columns="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="BtnTab1" Content="Пользователи" Height="80" Width="220" FontSize="16"
                    Click="BtnTab1_Click" ToolTip="Управление пользователями"/>
            <Button x:Name="BtnTab2" Content="Категории меню" Height="80" Width="220" FontSize="16"
                    Click="BtnTab2_Click" ToolTip="Справочник категорий"/>
            <Button x:Name="BtnTab3" Content="Заказы" Height="80" Width="220" FontSize="16"
                    Click="BtnTab3_Click" ToolTip="Управление заказами"/>
            <Button x:Name="BtnTab4" Content="Диаграммы и отчёты" Height="80" Width="220" FontSize="16"
                    Click="BtnTab4_Click" ToolTip="Аналитика и экспорт"/>
        </UniformGrid>
    </Grid>
</Page>