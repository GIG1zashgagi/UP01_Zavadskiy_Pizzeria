<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid Background="#F3F3F3">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Height="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Регистрация" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Grid Grid.Row="1" Margin="0,5">
                <TextBox x:Name="txtbxLog" ToolTip="Введите логин" TextChanged="txtbxLog_TextChanged"/>
                <Label x:Name="lblLogHint" Content="Введите логин" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"
                       MouseLeftButtonUp="lblLogHint_MouseLeftButtonUp"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,5">
                <PasswordBox x:Name="passBxFrst" ToolTip="Введите пароль" PasswordChanged="passBxFrst_PasswordChanged"/>
                <Label x:Name="lblPassHint" Content="Введите пароль" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"
                       MouseLeftButtonUp="lblPassHint_MouseLeftButtonUp"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,5">
                <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль" PasswordChanged="passBxScnd_PasswordChanged"/>
                <Label x:Name="lblPassSecHint" Content="Повторите пароль" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"
                       MouseLeftButtonUp="lblPassSecHint_MouseLeftButtonUp"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,5">
                <TextBox x:Name="txtbxFIO" ToolTip="Введите ФИО" TextChanged="txtbxFIO_TextChanged"/>
                <Label x:Name="lblFioHint" Content="Введите ФИО" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"
                       MouseLeftButtonUp="lblFioHint_MouseLeftButtonUp"/>
            </Grid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ComboBox x:Name="comboBxRole" Width="180" ToolTip="Выберите роль">
                    <ComboBoxItem Content="User" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>
                <Button x:Name="regButton" Content="Зарегистрироваться" Click="regButton_Click"
                        ToolTip="Создать аккаунт"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>