<Page x:Class="UP01_Zavadskiy_Pizzeria.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <Grid Background="#F3F3F3">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Height="420">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Grid Grid.Row="1" Margin="0,5">
                <TextBox x:Name="TextBoxLogin" ToolTip="Введите логин"
                         TextChanged="TextBoxLogin_TextChanged"/>
                <Label x:Name="lblLoginHint" Content="Введите логин" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,5">
                <PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                <Label x:Name="lblPassHint" Content="Введите пароль" Foreground="Gray"
                       Margin="8,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <TextBox Grid.Row="3" x:Name="captcha" Visibility="Hidden" IsReadOnly="True"
                     FontStyle="Italic" FontWeight="Heavy" FontSize="20" Foreground="Red"
                     Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                     ContextMenu="{x:Null}"/>
            <TextBox Grid.Row="4" x:Name="captchaInput" Visibility="Hidden"
                     ToolTip="Введите капчу" Margin="0,5"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="ButtonEnter" Content="Вход" Click="ButtonEnter_OnClick" ToolTip="Войти"/>
                <Button x:Name="submitCaptcha" Content="Подтвердить" Visibility="Hidden"
                        Click="submitCaptcha_Click" ToolTip="Подтвердить капчу"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button x:Name="ButtonReg" Content="Регистрация" Click="ButtonReg_Click" ToolTip="Создать аккаунт"/>
                <Button x:Name="ButtonChangePassword" Content="Смена пароля"
                        Click="ButtonChangePassword_Click" ToolTip="Изменить пароль"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>