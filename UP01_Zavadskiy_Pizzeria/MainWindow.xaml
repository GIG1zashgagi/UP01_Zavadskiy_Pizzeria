<Window x:Class="UP01_Zavadskiy_Pizzeria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления сетью пиццерий"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#233E76">
            <Button x:Name="BtnBack" Content="← Назад"
                    HorizontalAlignment="Left" Margin="10,0,0,0"
                    Click="BtnBack_Click" Width="90"/>
            <TextBlock x:Name="TbPageTitle" Text="Авторизация"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="BtnTheme" Content="Тема"
                    HorizontalAlignment="Right" Margin="0,0,10,0"
                    Click="BtnTheme_Click" Width="90"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <Grid Grid.Row="2" Background="#F3F3F3">
            <TextBlock x:Name="TbDateTime" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,15,0" FontSize="12"/>
        </Grid>
    </Grid>
</Window>